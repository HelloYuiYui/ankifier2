{
	// .wxt/tsconfig.json is generated by `wxt prepare` (run on install); it
	// supplies the paths, lib and jsx settings WXT's entrypoints need.
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	}
}
